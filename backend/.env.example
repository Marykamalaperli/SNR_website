APP_ENV=development
# JSON arrays, exact origins only. No wildcard CORS with credentials.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
SUPABASE_URL=
# Public publishable/anon key; requests still use the caller's Bearer JWT and RLS.
SUPABASE_PUBLISHABLE_KEY=
# Issuer/JWKS are derived from SUPABASE_URL when these are left empty.
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=
# No DB connection or server secret is needed until the membership adapter exists.
# Never expose service-role or database credentials in frontend variables.

APP_ENV=development
# JSON arrays, exact origins only. No wildcard CORS with credentials.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
# Target PostgreSQL connection. Use the Docker Compose value for the local stack.
DATABASE_URL=postgresql+psycopg://snr_nest:snr_nest_dev@localhost:5432/snr_nest
# Local HTTP development only. Production validation requires Secure cookies.
SESSION_COOKIE_SECURE=false
ACCESS_SESSION_MINUTES=15
REFRESH_SESSION_DAYS=30
# Required only when manually running scripts/seed_dev.py.
SNR_DEV_SEED_PASSWORD=
# Never expose database credentials or server secrets in frontend variables.

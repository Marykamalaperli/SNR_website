APP_ENV=development
# JSON arrays, exact origins only. No wildcard CORS with credentials.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
# Target PostgreSQL connection. Use the Docker Compose value for the local stack.
DATABASE_URL=postgresql+psycopg://snr_nest:snr_nest_dev@localhost:5432/snr_nest
SUPABASE_URL=
# Public publishable/anon key; requests still use the caller's Bearer JWT and RLS.
SUPABASE_PUBLISHABLE_KEY=
# Issuer/JWKS are derived from SUPABASE_URL when these are left empty.
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=
# Supabase settings remain only for transition compatibility and will be removed
# after the target identity repository replaces the historical adapter.
# Never expose database credentials or server secrets in frontend variables.

# Public browser configuration only. Never use a service-role key here.
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Supabase database authorization works without Cloud Run. Use api only with a deployed API.
VITE_AUTH_SESSION_SOURCE=supabase
# Build-only canonical HTTPS origin. Leave empty until the real domain is known.
PUBLIC_SITE_URL=

{
  "name": "snr-nest-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "demo:build": "vite build --config attendance-demo/vite.config.js",
    "demo:preview": "vite preview --config attendance-demo/vite.config.js",
    "demo:test": "npm run demo:build && playwright test --config playwright.demo.config.js",
    "dev": "vite",
    "build": "vite build && node scripts/generate-sitemap.mjs && node scripts/generate-server-config.mjs",
    "test:server": "node --test server/*.test.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@supabase/supabase-js": "2.119.0",
    "jsqr": "1.4.0",
    "lucide-react": "1.69.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}

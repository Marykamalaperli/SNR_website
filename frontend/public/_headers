  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://*.supabase.co https://*.run.app; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
